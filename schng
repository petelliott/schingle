#!/usr/bin/env -S guile -s
!#

(add-to-load-path (dirname (current-filename)))

(use-modules (ice-9 getopt-long)
             (ice-9 ftw)
             (ice-9 threads)
             (schingle)
             (schingle build)
             (schingle render)
             (schingle load)
             (schingle ftypes)
             (schingle context))

(define (load-site-scm site)
  (define module (make-fresh-user-module))

  (save-module-excursion
   (lambda ()
     (set-current-module module)
     (use-modules (schingle))))

  (ftw site
       (lambda (filename statinfo flag)
         (when (and (eq? flag 'regular)
                  (equal? (file-extension filename) ".scm"))
             (save-module-excursion
              (lambda ()
                (set-current-module module)
                (load (canonicalize-path filename)))))
             #t)))

(define (build site output port address)
  (display "build is not yet implemented\n")
  (exit 1))

(define (build-static site output)
  (with-schingle-context
   (lambda ()
     (load-site-scm site)
     (build-static-directory output))))

(define (run site port address)
  (with-schingle-context
   (lambda ()
     (load-site-scm site)
     (run-schingle #:port port
                   #:addr address))))

;; guile's run-server doesn't play nice with (cancel-thread)
(define (jank-subprocess thunk)
  (define pid (primitive-fork))
  (if (= pid 0)
      (begin
        (thunk)
        (exit 0))
      pid))



(define (watch site port address watch-dirs)
  (define pid (jank-subprocess
               (lambda () (run site port address))))
  (define ret (system (format #f "inotifywait -r -e modify,create,delete,move~{ ~a~}" watch-dirs)))
  ;; this seems pretty jank
  (kill pid SIGKILL)
  (waitpid pid)
  (if (= ret 0)
      (begin
        (watch site port address watch-dirs))
      (newline)))


;; parse options and run.

(define option-spec
  '((include (single-char #\i) (value #t))
    (load (single-char #\l) (value #t))
    (output (single-char #\o) (value #t))
    (port (single-char #\p) (value #t))
    (address (single-char #\a) (value #t))
    (help (single-char #\h) (value #f))))

(define options (getopt-long (command-line) option-spec))

(define* (usage #:optional (error 2))
  (format (current-error-port) "Usage: ~a [--include <includedir> ...] [--load <scm load dir> ...] {build|static|run|watch} [--port <port>] [--address <addr>] <site> [--output <build>]\n" (car (command-line)))
  (exit error))

(when (option-ref options 'help #f)
  (usage 0))

(define positional (option-ref options '() '()))

(unless (= (length positional) 2)
  (usage))

(define command (car positional))
(define dir (cadr positional))

(define (ensure-output command)
  (define output (option-ref options 'output #f))
  (unless output
    (format (current-error-port) "~a: output is required for command ~a\n" (car (command-line)) command)
    (exit 1))
  output)

(define (option-ref-all options key)
  (cond
   ((null? options) '())
   ((eq? (caar options) key)
    (cons (cdar options) (option-ref-all (cdr options) key)))
   (else
    (option-ref-all (cdr options) key))))


;; set up common schingle config
(add-renderer ".scm" renderer-ignore)
(when (and (file-exists? dir) (file-is-directory? dir))
  (serve-directory dir "/"))

(for-each
 (lambda (include-dir)
   (schingle-include-path include-dir))
 (option-ref-all options 'include))

(for-each
 (lambda (load-dir)
   (add-to-load-path load-dir))
 (option-ref-all options 'load))

;; go
(cond
 ((equal? command "build")
  (build dir (ensure-output "build")
         (string->number (option-ref options 'port "80"))
         (option-ref options 'address INADDR_ANY)))
 ((equal? command "static")
  (build-static dir (ensure-output "static")))
 ((equal? command "run")
  (run dir
       (string->number (option-ref options 'port "8000"))
       (option-ref options 'address INADDR_ANY)))
 ((equal? command "watch")
  (watch dir
       (string->number (option-ref options 'port "8000"))
       (option-ref options 'address INADDR_ANY)
       (append (list dir)
               (option-ref-all options 'include)
               (option-ref-all options 'load))))
 (else
  (usage)))
